{
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "b2b.cildroplywood.ro"
        }
      ],
      "destination": "https://cildroplywood.ro/$1",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/plywood-sheets(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/plywood-doors(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/plywood-sink(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/dining-and-bistro-tables(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/portfolio(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/comments(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/feed(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/de(/.*)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ro/category(/.*)?",
      "destination": "/ro/",
      "permanent": true
    },
    {
      "source": "/ro/(chiuveta-lemn|contact-us|privacy-policy)(/.*)?",
      "destination": "/ro/",
      "permanent": true
    },
    {
      "source": "/page-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/category-sitemap.xml",
      "destination": "/sitemap.xml",
      "permanent": true
    }
  ]
}